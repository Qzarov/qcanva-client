# `vite build --mode dev` (npm run build:dev): the dev stand, dev-qcanva.qzarov.pro.
# Its nginx proxies /api and the sockets to the dev backend, so the API is
# same-origin. Without this file the build would take .env.production and
# point the dev stand at the production API.
VITE_API_URL=/api
VITE_CANONICAL_ORIGIN=https://dev-qcanva.qzarov.pro
