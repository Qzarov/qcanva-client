{
  "name": "canvas-server-front",
  "private": true,
  "version": "1.6.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:visual": "playwright test tests/theme.visual.spec.ts",
    "test:visual:update": "playwright test tests/theme.visual.spec.ts --update-snapshots",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build:debug": "npm run android:sync && cd android && ./gradlew :app:assembleDebug",
    "android:bundle:release": "npm run android:sync && cd android && ./gradlew :app:bundleRelease",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@lucide/vue": "^1.40.0",
    "@tiptap/extension-code-block-lowlight": "2.27.2",
    "@tiptap/extension-collaboration": "^2.27.2",
    "@tiptap/extension-collaboration-cursor": "^2.26.2",
    "@tiptap/extension-drag-handle": "2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-node-range": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@tiptap/suggestion": "^2.27.2",
    "@tiptap/vue-3": "^2.27.2",
    "highlight.js": "11.12.0",
    "lowlight": "3.3.0",
    "marked": "^16.4.1",
    "perfect-freehand": "^1.2.3",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.4",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.6.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.8.1",
    "jsdom": "^29.1.1",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.1.0"
  }
}
